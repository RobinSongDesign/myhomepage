---
/** A grid of <Card>s. */
interface Props {
  cols?: 2 | 3 | 4;
  span?: 'full' | 'text';
}

const { cols = 2, span = 'full' } = Astro.props;
---

<div class:list={['cards', { 'span-full': span === 'full' }]} data-cols={cols}>
  <slot />
</div>

<style>
  .cards {
    display: grid;
    gap: var(--col-gap);
    align-items: stretch;
  }

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cards[data-cols='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cards[data-cols='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
