---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiLogo from '../components/AsciiLogo.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn’t exist.">
  <section class="lost wrap">
    <div class="lost-canvas"><AsciiLogo class="lost-logo" /></div>
    <div class="lost-text">
      <p class="label">Error 404</p>
      <h1 class="code">Lost in orbit.</h1>
      <p class="lede">This page doesn’t exist — it may have moved when the site was rebuilt.</p>
      <div class="actions">
        <a class="btn" href="/">Home <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/#work">All work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto;
    column-gap: var(--col-gap);
    min-height: calc(100svh - var(--header-h));
    padding-bottom: var(--space-16);
  }

  .lost-canvas {
    position: relative;
    grid-column: 1 / -1;
    min-height: clamp(16rem, 42svh, 28rem);
    margin-inline: calc(-1 * var(--gutter));
    touch-action: pan-y;
  }

  .lost-canvas :global(.lost-logo) {
    position: absolute;
    inset: 0;
  }

  .lost-text {
    grid-column: 1 / -1;
    display: grid;
    align-content: end;
    gap: var(--space-6);
  }

  .code {
    font-size: clamp(3rem, 1.4rem + 7vw, 8rem);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
  }

  .lede {
    max-width: 28ch;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 64rem) {
    .lost {
      grid-template-rows: 1fr;
    }

    .lost-canvas {
      grid-column: 6 / -1;
      grid-row: 1;
      margin: 0 calc(-1 * var(--gutter)) 0 0;
    }

    .lost-text {
      grid-column: 1 / span 5;
      grid-row: 1;
    }
  }
</style>
