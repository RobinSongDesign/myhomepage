  },
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** Give the icon an accessible name; omit when it sits next to visible text. */
  title?: string;
}

const { name, size = '1em', class: className, title } = Astro.props;
const icon = icons[name];
const filled = 'fill' in icon && icon.fill;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : 1.5}
  stroke-linecap={filled ? undefined : 'square'}
  stroke-linejoin={filled ? undefined : 'miter'}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path d={icon.d} />
</svg>
