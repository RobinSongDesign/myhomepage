---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/content/Section.astro';
import Timeline from '../components/content/Timeline.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/about/portrait.png';
import { site } from '../data/site';
import { education, experience, languages, recognition, toolkit } from '../data/about';
---

<BaseLayout
  title="About"
  description="Robin Song — computational designer and developer. Education, experience, toolkit and contact."
  image={portrait}
>
  <header class="intro wrap">
    <h1 class="label crumbs">About</h1>

    <div class="portrait" data-reveal>
      <Image
        src={portrait}
        alt="Portrait of Robin Song"
        width={1440}
        widths={[420, 720, 1080, 1440]}
        sizes="(min-width: 64rem) 36vw, 100vw"
        loading="eager"
      />
    </div>

    <div class="text">
      <p class="statement">
        I’m Robin Song, a computational designer and developer. My interests span architecture and landscape, with a
        particular focus on combining algorithms with design and on the relationship between form and mechanics.
      </p>
      <p class="now">
        Currently a Design System Analyst at Foster + Partners; previously an AI product manager at ByteDance. I hold
        an MSc in Architectural Computation from UCL and a degree in landscape architecture from Beijing Forestry
        University.
      </p>
      <div class="actions">
        <a class="btn" href={site.cv} download="CV_Robin_Song.pdf">Download CV <Icon name="download" /></a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email me <Icon name="arrow-up-right" /></a>
      </div>
    </div>
  </header>

  <div class="body wrap">
    <Section title="Experience">
      <Timeline entries={experience} />
    </Section>

    <Section title="Education">
      <Timeline entries={education} />
    </Section>

    <Section title="Toolkit">
      <div class="toolkit">
        {
          toolkit.map((group) => (
            <div class="tool-group">
              <p class="label">{group.group}</p>
              <ul role="list">
                {group.tools.map((tool) => (
                  <li class="tool">
                    <span class="tile" aria-hidden="true">
                      {tool.logo ? (
                        <img src={tool.logo.src} alt="" width="22" height="22" loading="lazy" />
                      ) : (
                        <span class="mono-tile">{tool.mono}</span>
                      )}
                    </span>
                    <span class="tool-name">{tool.name}</span>
                    <span class="tool-note">{tool.note}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>

    <Section title="Recognition">
      <Timeline entries={recognition} />
    </Section>

    <Section title="Contact">
      <dl class="contact">
        <div>
          <dt class="label">Email</dt>
          <dd><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt class="label">Phone</dt>
          <dd>
            <a class="text-link" href="tel:+447726437631">+44 7726 437631</a><br />
            <a class="text-link" href="tel:+8618565835262">+86 185 6583 5262</a>
          </dd>
        </div>
        <div>
          <dt class="label">Based in</dt>
          <dd>London, United Kingdom<br />Shenzhen, China</dd>
        </div>
        <div>
          <dt class="label">Languages</dt>
          <dd>{languages.map((language) => <span class="line">{language}</span>)}</dd>
        </div>
        <div>
          <dt class="label">Elsewhere</dt>
          <dd class="social">
            <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /> LinkedIn</a>
            <a href={site.socials.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> GitHub</a>
            <button type="button" data-open-wechat><Icon name="wechat" /> WeChat</button>
          </dd>
        </div>
      </dl>
    </Section>
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: var(--space-10);
    padding-top: clamp(var(--space-10), 6vw, var(--space-24));
  }

  .crumbs {
    grid-column: 1 / -1;
  }

  .portrait {
    grid-column: 1 / span 5;
    align-self: start;
    background: var(--paper-2);
  }

  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .text {
    grid-column: 7 / -1;
    display: grid;
    align-content: start;
    gap: var(--space-8);
  }

  .statement {
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    text-wrap: pretty;
  }

  .now {
    max-width: 52ch;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .body {
    counter-reset: section;
    padding-top: var(--section);
  }

  /* Toolkit */
  .toolkit {
    display: grid;
    gap: var(--space-10);
  }

  .tool-group ul {
    margin-top: var(--space-3);
    border-top: 1px solid var(--rule-strong);
  }

  .tool {
    display: grid;
    grid-template-columns: 2.75rem minmax(8rem, 1fr) 2fr;
    align-items: center;
    gap: var(--space-2) var(--col-gap);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .tile {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule);
    background: var(--plate);
  }

  .tile img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.85;
    transition: filter var(--dur-2), opacity var(--dur-2);
  }

  .tool:hover .tile img {
    filter: none;
    opacity: 1;
  }

  .mono-tile {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: #161615;
  }

  .tool-name {
    font-weight: 500;
  }

  .tool-note {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  /* Contact */
  .contact {
    display: grid;
  }

  .contact > div:first-child {
    padding-top: 0;
  }

  .contact > div {
    display: grid;
    grid-template-columns: minmax(8.5rem, 1fr) 3fr;
    gap: var(--space-2) var(--col-gap);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .contact dt {
    padding-top: 0.3em;
  }

  .line {
    display: block;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .social a,
  .social button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    transition: color var(--dur-1);
  }

  .social a:hover,
  .social button:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 63.99rem) {
    .portrait {
      grid-column: 1 / span 6;
    }

    .text {
      grid-column: 7 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .portrait,
    .text {
      grid-column: 1 / -1;
    }

    .portrait {
      max-width: 26rem;
    }

    .tool {
      grid-template-columns: 2.75rem 1fr;
    }

    .tool-note {
      grid-column: 2;
    }

    .contact > div {
      grid-template-columns: 1fr;
    }
  }
</style>
