---
import BaseLayout from './BaseLayout.astro';
import Media from '../components/Media.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import ProjectPager from '../components/ProjectPager.astro';
import { getProject, projectNumber, type ProjectLink } from '../data/projects';

interface Props {
  /** Project id from src/data/projects.ts */
  id: string;
}

const project = getProject(Astro.props.id);
const hero = project.hero ?? project.cover;
const hasCustomCover = Astro.slots.has('cover');

const linkIcon: Record<ProjectLink['kind'], IconName> = {
  github: 'github',
  download: 'download',
  paper: 'paper',
  demo: 'play',
};
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout title={project.title} description={project.subtitle} image={project.cover}>
  <article class="project">
    <header class="head wrap">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a href="/#work">Work</a>
        <span aria-hidden="true">/</span>
        <span>{project.category}</span>
        <span aria-hidden="true">/</span>
        <span>{projectNumber(project)}</span>
      </nav>

      <h1 class="title">{project.title}</h1>
      <p class="subtitle">{project.subtitle}</p>

      <dl class="title-block">
        {
          project.facts.map((fact) => (
            <div class="cell">
              <dt class="label">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
        {
          project.links && (
            <div class="cell cell--links">
              <dt class="label">Resources</dt>
              <dd>
                <ul role="list">
                  {project.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={isExternal(link.href) ? '_blank' : undefined}
                        rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                        download={link.kind === 'download' ? '' : undefined}
                      >
                        <Icon name={linkIcon[link.kind]} />
                        {link.label}
                        {isExternal(link.href) && <Icon name="arrow-up-right" class="ext" />}
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="cover">
      {
        hasCustomCover ? (
          <slot name="cover" />
        ) : (
          <Media src={hero} alt={`${project.title} — ${project.subtitle}`} loading="eager" fetchpriority="high" />
        )
      }
    </div>

    <div class="body wrap">
      <slot />
    </div>

    <ProjectPager project={project} />
  </article>
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding-top: clamp(var(--space-10), 6vw, var(--space-24));
    padding-bottom: var(--space-10);
  }

  .crumbs {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    margin-bottom: var(--space-8);
  }

  .crumbs a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.25em;
  }

  .crumbs a:hover {
    color: var(--accent-ink);
  }

  .title {
    grid-column: 1 / -1;
    font-size: clamp(2.75rem, 1.5rem + 5.4vw, 7.25rem);
    line-height: 0.92;
    letter-spacing: var(--tracking-display);
  }

  .subtitle {
    grid-column: 1 / span 8;
    margin-top: var(--space-6);
    max-width: 36ch;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--ink-2);
  }

  /* The title block: a nod to the stamp in the corner of every drawing sheet. */
  .title-block {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    margin-top: var(--space-12);
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule);
  }

  .cell {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-4);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .cell dd {
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .cell--links ul {
    display: grid;
    gap: var(--space-1);
  }

  .cell--links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    transition: color var(--dur-1);
  }

  .cell--links a:hover {
    color: var(--accent-ink);
  }

  .cell--links :global(.ext) {
    width: 0.75em;
    height: 0.75em;
    color: var(--ink-3);
  }

  .cover {
    position: relative;
    background: var(--paper-2);
  }

  .cover > :global(img) {
    width: 100%;
    height: min(88svh, 56.25vw);
    min-height: 18rem;
    object-fit: cover;
  }

  .body {
    counter-reset: section fig;
    padding-top: var(--section);
  }

  @media (max-width: 47.99rem) {
    .subtitle {
      grid-column: 1 / -1;
    }
  }
</style>
