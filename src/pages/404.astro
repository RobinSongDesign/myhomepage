---
import BaseLayout from '../layouts/BaseLayout.astro';
import FieldCanvas from '../components/FieldCanvas.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn’t exist.">
  <section class="lost">
    <FieldCanvas class="lost-field" spacing={30} />
    <div class="wrap lost-inner">
      <p class="label">Error 404</p>
      <h1 class="code">Off the grid.</h1>
      <p class="lede">This page doesn’t exist — it may have moved when the site was rebuilt.</p>
      <div class="actions">
        <a class="btn" href="/">Home <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/#work">All work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: flex;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
  }

  .lost :global(.lost-field) {
    position: absolute;
    inset: 0;
    -webkit-mask-image: radial-gradient(circle at 70% 40%, #000 20%, transparent 75%);
    mask-image: radial-gradient(circle at 70% 40%, #000 20%, transparent 75%);
  }

  .lost-inner {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--space-6);
    padding-block: var(--space-16);
  }

  .code {
    font-size: clamp(3rem, 1.4rem + 7vw, 8rem);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
  }

  .lede {
    max-width: 28ch;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
