---
import Icon from './Icon.astro';
import { getNeighbours, projectNumber, type Project } from '../data/projects';

interface Props {
  project: Project;
}

const { prev, next } = getNeighbours(Astro.props.project);
---

<nav class="pager wrap" aria-label="More projects">
  <a class="item prev" href={prev.href} rel="prev">
    <span class="label"><Icon name="arrow-left" /> Previous · {projectNumber(prev)}</span>
    <span class="name">{prev.title}</span>
  </a>
  <a class="item next" href={next.href} rel="next">
    <span class="label">Next · {projectNumber(next)} <Icon name="arrow-right" /></span>
    <span class="name">{next.title}</span>
  </a>
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--col-gap);
    margin-top: var(--section);
  }

  .item {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-strong);
  }

  .next {
    text-align: right;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .next .label {
    justify-content: flex-end;
  }

  .name {
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    transition: color var(--dur-1);
  }

  .item:hover .name {
    color: var(--accent-ink);
  }
</style>
