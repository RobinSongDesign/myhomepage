---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const section = path.startsWith('/about') ? 'about' : path.startsWith('/projects') ? 'work' : null;
---

<header class="site-header" data-site-header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <img class="brand-mark" src="/images/logo.svg" alt="" width="31" height="30" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/#work" data-active={section === 'work' || undefined}>Work</a>
      <a href="/about.html" data-active={section === 'about' || undefined} aria-current={section === 'about' ? 'page' : undefined}>
        About
      </a>
      <a href={site.cv} download="CV_Robin_Song.pdf">CV</a>
    </nav>

    <ThemeToggle />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-right: auto;
  }

  .brand-mark {
    width: 31px;
    height: auto;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: rotate(-24deg);
  }

  :global([data-theme='dark']) .brand-mark {
    filter: invert(1);
  }

  .brand-name {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: clamp(var(--space-4), 2.6vw, var(--space-8));
  }

  .nav a {
    position: relative;
    padding-block: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color var(--dur-1);
  }

  .nav a:hover,
  .nav a[data-active] {
    color: var(--ink);
  }

  .nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.2rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .nav a:hover::after,
  .nav a[data-active]::after {
    transform: scaleX(1);
  }

  @media (max-width: 23.75rem) {
    .brand-name {
      display: none;
    }
  }
</style>
